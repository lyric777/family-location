{
  "expo": {
    "name": "Family Location",
    "slug": "family-location",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "familylocation",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "relayUrl": "http://192.168.0.106:8787"
    },
    "android": {
      "package": "com.lyric777.familylocation"
    },
    "plugins": [
      "expo-router"
    ],
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "0.1.0",
    "experiments": {
      "typedRoutes": true
    }
  }
}
